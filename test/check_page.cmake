# A line "+ text" of the expected file must stand in the page. A line "- text" must not.
# A page also holds no empty row and no unreplaced tag of a template.
file(READ "${PAGE}" text)
file(STRINGS "${EXPECTED}" lines)
foreach(line IN LISTS lines)
  string(SUBSTRING "${line}" 0 2 mark)
  string(SUBSTRING "${line}" 2 -1 needle)
  string(FIND "${text}" "${needle}" at)
  if(mark STREQUAL "+ " AND at EQUAL -1)
    message(FATAL_ERROR "the page does not hold: ${needle}")
  elseif(mark STREQUAL "- " AND NOT at EQUAL -1)
    message(FATAL_ERROR "the page holds: ${needle}")
  elseif(NOT mark STREQUAL "+ " AND NOT mark STREQUAL "- ")
    message(FATAL_ERROR "a line of ${EXPECTED} starts with neither + nor -: ${line}")
  endif()
endforeach()
foreach(forbidden IN ITEMS "<li></li>" "<code></code>" "<pre></pre>" "<p class=\"text\"></p>" "{{#" "{{/" "{{>")
  string(FIND "${text}" "${forbidden}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "the page holds: ${forbidden}")
  endif()
endforeach()
