# mandoc -T lint -W warning prints nothing for each page, and each name of the file EXPECTED stands as a page.
file(GLOB pages ${MAN_DIR}/*.3)
execute_process(COMMAND ${MANDOC} -T lint -W warning ${pages} OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE status)
if(NOT "${out}${err}" STREQUAL "")
  message(FATAL_ERROR "mandoc -T lint -W warning:\n${out}${err}")
endif()
file(STRINGS ${EXPECTED} names)
foreach(name IN LISTS names)
  if(NOT EXISTS ${MAN_DIR}/${name})
    message(FATAL_ERROR "the man page ${name} is missing")
  endif()
endforeach()
# No line of a rendered page is longer than 80 columns (bold and underline marks do not count).
foreach(page IN LISTS pages)
  execute_process(COMMAND sh -c "\"$0\" -T ascii -O width=80 \"$1\" | sed 's/.\\x08//g' | awk 'length > 80 { print length \": \" $0 }'" ${MANDOC} ${page} OUTPUT_VARIABLE long_lines RESULT_VARIABLE long_status)
  if(NOT long_status EQUAL 0)
    message(FATAL_ERROR "the check of the width of ${page} did not run")
  endif()
  if(NOT "${long_lines}" STREQUAL "")
    get_filename_component(page_name ${page} NAME)
    message(FATAL_ERROR "${page_name}: a line longer than 80 columns:\n${long_lines}")
  endif()
endforeach()
