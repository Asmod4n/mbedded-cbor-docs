{{>head}}
<h1>{{name}}</h1>
{{#has_snippet}}<pre>{{{snippet_html}}}</pre>
{{/has_snippet}}<table>
{{#entries}}<tr><td><a href="#{{id}}">{{qname}}</a></td><td>{{{brief_html}}}</td></tr>
{{/entries}}</table>
{{>entries}}<h2 id="errors-of-each-class">Errors of each class</h2>
<div class="entries">
{{#errors}}<section><h3>{{scope}}</h3>
<pre>{{names}}</pre>
</section>
{{/errors}}</div>
{{>foot}}
