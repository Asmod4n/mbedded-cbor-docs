<div class="entries">
{{#entries}}<section id="{{id}}">
<h2>{{qname}}</h2>
<pre>{{{sigs_html}}}</pre>
{{#has_body}}<div class="text">{{{body_html}}}</div>
{{/has_body}}{{#has_example}}<pre class="code">{{{example_html}}}</pre>
{{/has_example}}{{#has_play}}<div class="example" data-play>
<button class="run" type="button" hidden>&#9654; Run</button>
<pre class="code editable" contenteditable="true" spellcheck="false" aria-label="Example, editable">{{{example_html}}}</pre>
</div>
{{/has_play}}</section>
{{/entries}}</div>

