# A text of five words or more stands once in the pages. The texts are the paragraphs of <p> and the cells of <td>.
set(seen)
foreach(page IN LISTS PAGES)
  file(READ "${page}" text)
  string(REGEX MATCHALL "<(p class=\"text\"|td)>[^<]*</(p|td)>" cells "${text}")
  foreach(cell IN LISTS cells)
    string(REGEX REPLACE "^<[^>]*>|</[a-z]*>$" "" cell "${cell}")
    string(REPLACE "\n\n" ";" paragraphs "${cell}")
    foreach(paragraph IN LISTS paragraphs)
      string(REGEX MATCHALL "[^ \n]+" words "${paragraph}")
      list(LENGTH words count)
      if(count GREATER_EQUAL 5)
        if("${paragraph}" IN_LIST seen)
          message(SEND_ERROR "a text stands twice: ${paragraph}")
        endif()
        list(APPEND seen "${paragraph}")
      endif()
    endforeach()
  endforeach()
endforeach()
